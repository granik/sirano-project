<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Modules\LearningModule\Domain\Entity\ModulesArticles" table="modules_articles">
        <id name="module" association-key="true" />
        <id name="article" association-key="true" />

        <many-to-one field="module" target-entity="App\Modules\LearningModule\Domain\Entity\Module">
            <join-column name="module_id" referenced-column-name="id" on-delete="CASCADE" />
        </many-to-one>
        <many-to-one field="article" target-entity="App\Modules\Article\Domain\Entity\Article">
            <join-column name="article_id" referenced-column-name="id" on-delete="CASCADE" />
        </many-to-one>
    </entity>
</doctrine-mapping>